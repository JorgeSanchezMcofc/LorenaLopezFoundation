{
  // Configuración de Cloudflare Workers para lorenalopezfoundation.org
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lorena-lopez-foundation",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    // Los archivos públicos viven en la raíz del repo; .assetsignore excluye lo privado.
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Correo del formulario de contacto (Cloudflare Email Routing).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "formulario@lorenalopezfoundation.org"
  }
  // CONTACT_TO (buzón verificado que recibe los mensajes) se guarda como secreto:
  //   npx wrangler secret put CONTACT_TO
}
