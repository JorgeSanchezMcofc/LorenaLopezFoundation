{
  // Configuración de Cloudflare Workers para lorenalopezfoundation.org
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lorena-lopez-foundation",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Los archivos públicos viven en la raíz del repo; .assetsignore excluye lo privado.
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*", "/admin*", "/navidad*", "/ninos*"]
  },
  // Base de datos de perfiles y regalos. El database_id se obtiene al crearla:
  //   npx wrangler d1 create llf-ninos
  "d1_databases": [
    { "binding": "DB", "database_name": "llf-ninos", "database_id": "b3a908ac-3aeb-4576-94c1-6cc1b580e03d", "migrations_dir": "migrations" }
  ],
  // Caricaturas (borradores privados y aprobadas). Crear con:
  //   npx wrangler r2 bucket create llf-caricaturas
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "llf-caricaturas" }],
  // Correo del formulario de contacto (Cloudflare Email Routing).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "formulario@lorenalopezfoundation.org",
    // "photo": la foto va como referencia a OpenAI. "description": Claude describe rasgos y OpenAI dibuja solo con texto.
    "IMAGE_MODE": "photo",
    "IMAGE_MODEL": "gpt-image-2.5-sunburst",
    "IMAGE_QUALITY": "medium"
  }
  // Secretos (nunca en este archivo ni en el repo), con `npx wrangler secret put NOMBRE`:
  //   CONTACT_TO          buzón verificado que recibe los mensajes del formulario
  //   ANTHROPIC_API_KEY   perfiles con Claude
  //   OPENAI_API_KEY      caricaturas
  //   ACCESS_TEAM_DOMAIN  p. ej. https://lorenalopez.cloudflareaccess.com
  //   ACCESS_AUD          "Application Audience (AUD) Tag" de la app de Cloudflare Access
  //   ADMIN_EMAILS        correos de Jorge y Lorena separados por coma
}
